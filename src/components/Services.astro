---
import { services } from "../data/content.js";
---

<section class="services section" id="servicios">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Qué hago</p>
        <h2 class="section-title">Servicios <em>creativos</em></h2>
      </div>
      <p class="lede">
        De la idea a la pantalla: producción audiovisual completa adaptada
        a cada marca y formato.
      </p>
    </div>

    <div class="services-list" data-reveal-group>
      {services.map((s) => (
        <div class="service-row">
          <span class="service-index">{s.index}</span>
          <h3 class="service-title">{s.title}</h3>
          <p class="service-desc">{s.description}</p>
          <span class="service-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M7 17 17 7M7 7h10v10" />
            </svg>
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-list {
    border-top: 1px solid var(--line);
  }

  .service-row {
    position: relative;
    display: grid;
    grid-template-columns: 4rem 1fr 1.4fr 3rem;
    align-items: center;
    gap: 1.5rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--line);
    transition: background 0.35s var(--ease-out), padding-left 0.35s var(--ease-out);
  }

  .service-row:hover {
    background: var(--surface);
    padding-left: 1rem;
  }

  .service-index {
    font-family: var(--font-display);
    color: var(--text-faint);
    font-size: 1rem;
  }

  .service-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    line-height: 1.05;
  }

  .service-desc {
    color: var(--text-dim);
    max-width: 46ch;
  }

  .service-arrow {
    justify-self: end;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition: border-color 0.35s var(--ease-out), transform 0.35s var(--ease-out),
      color 0.35s var(--ease-out);
  }

  .service-arrow svg {
    width: 14px;
    height: 14px;
  }

  .service-row:hover .service-arrow {
    border-color: var(--accent);
    color: var(--accent);
    transform: rotate(45deg);
  }

  @media (max-width: 760px) {
    .service-row {
      grid-template-columns: 2.5rem 1fr;
      grid-template-areas:
        "index arrow"
        "title title"
        "desc desc";
      row-gap: 0.6rem;
    }

    .service-index {
      grid-area: index;
    }

    .service-arrow {
      grid-area: arrow;
    }

    .service-title {
      grid-area: title;
    }

    .service-desc {
      grid-area: desc;
    }
  }
</style>
