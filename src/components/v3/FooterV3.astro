---
const year = new Date().getFullYear();
---

<footer class="footerv3">
  <div class="container footerv3-inner">
    <span class="footerv3-logo">MATEO<span>*</span></span>
    <p>&copy; {year} — Producciones con actitud.</p>
    <a href="#inicio" class="btn3 btn3-outline footerv3-top">Arriba ↑</a>
  </div>
</footer>

<style>
  .footerv3 {
    border-top: 1px solid var(--line);
    padding-block: 2.5rem;
  }

  .footerv3-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
    color: var(--text-dim);
  }

  .footerv3-logo {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--text);
  }

  .footerv3-logo span {
    color: var(--pink);
  }

  .footerv3-top {
    padding: 0.55rem 1.1rem;
    font-size: 0.7rem;
  }
</style>
