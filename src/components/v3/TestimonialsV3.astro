---
import { testimonials } from "../../data/content.js";
const grads = ["var(--gradient-1)", "var(--gradient-2)", "var(--gradient-1)"];
---

<section class="testiv3 section" id="testimonios">
  <div class="container testiv3-wrap">
    <div data-reveal>
      <span class="chip"><span class="chip-dot"></span> Clientes</span>
      <h2 class="big-title">LO QUE <span class="grad">DICEN.</span></h2>
      <p class="lede testiv3-hint">Arrastra la tarjeta o usa el botón para pasar a la siguiente.</p>
    </div>

    <div class="testiv3-stack-wrap" data-reveal>
      <div class="testiv3-stack" id="testiv3-stack">
        {testimonials.map((t, i) => (
          <figure class="testiv3-card" style={`--grad:${grads[i % grads.length]}`} data-order={i}>
            <blockquote>&ldquo;{t.quote}&rdquo;</blockquote>
            <figcaption>{t.name}<span>{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
      <button id="testiv3-next" class="btn3 btn3-solid testiv3-next">Siguiente ✦</button>
    </div>
  </div>
</section>

<script>
  const stack = document.getElementById("testiv3-stack");
  const nextBtn = document.getElementById("testiv3-next");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".testiv3-card"));
  let order = cards.map((_, i) => i);

  const layout = () => {
    order.forEach((cardIndex, position) => {
      const card = cards[cardIndex];
      const offset = position * 14;
      const scale = 1 - position * 0.05;
      card.style.transform = `translateY(${offset}px) scale(${scale}) rotate(${position === 0 ? 0 : position % 2 === 0 ? 2 : -2}deg)`;
      card.style.zIndex = String(cards.length - position);
      card.style.opacity = position > 2 ? "0" : "1";
    });
  };

  const advance = () => {
    order.push(order.shift() as number);
    layout();
  };

  nextBtn?.addEventListener("click", advance);

  layout();

  let isDown = false;
  let startX = 0;
  let currentDx = 0;

  const front = () => cards[order[0]];

  stack?.addEventListener("pointerdown", (e) => {
    if (e.target !== front() && !front().contains(e.target as Node)) return;
    isDown = true;
    startX = e.clientX;
    front().style.transition = "none";
    (e.target as HTMLElement).setPointerCapture(e.pointerId);
  });

  stack?.addEventListener("pointermove", (e) => {
    if (!isDown) return;
    currentDx = e.clientX - startX;
    front().style.transform = `translateX(${currentDx}px) rotate(${currentDx / 20}deg)`;
  });

  const release = () => {
    if (!isDown) return;
    isDown = false;
    const card = front();
    card.style.transition = "transform 0.4s cubic-bezier(0.16,1,0.3,1)";
    if (Math.abs(currentDx) > 90) {
      const dir = currentDx > 0 ? 1 : -1;
      card.style.transform = `translateX(${dir * 400}px) rotate(${dir * 20}deg)`;
      setTimeout(() => {
        advance();
      }, 220);
    } else {
      layout();
    }
    currentDx = 0;
  };

  stack?.addEventListener("pointerup", release);
  stack?.addEventListener("pointerleave", () => {
    if (isDown) release();
  });
</script>

<style>
  .testiv3-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .testiv3-hint {
    margin-top: 1.25rem;
  }

  .testiv3-stack-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  .testiv3-stack {
    position: relative;
    width: 100%;
    max-width: 380px;
    height: 300px;
  }

  .testiv3-card {
    position: absolute;
    inset: 0;
    padding: 2rem;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: grab;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    touch-action: pan-y;
  }

  .testiv3-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 24px;
    background: var(--grad);
    opacity: 0.12;
    z-index: -1;
  }

  .testiv3-card blockquote {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.35;
    text-transform: none;
  }

  .testiv3-card figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .testiv3-card figcaption span {
    font-weight: 400;
    color: var(--text-dim);
    font-size: 0.78rem;
  }

  @media (max-width: 860px) {
    .testiv3-wrap {
      grid-template-columns: 1fr;
    }
  }
</style>
