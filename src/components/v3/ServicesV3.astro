---
import { services } from "../../data/content.js";
const grads = ["var(--gradient-1)", "var(--gradient-2)"];
---

<section class="servicesv3 section" id="servicios">
  <div class="container">
    <div class="workv3-head" data-reveal>
      <div>
        <span class="chip"><span class="chip-dot"></span> Qué hago</span>
        <h2 class="big-title">SERVICIOS <span class="grad">A TOPE.</span></h2>
      </div>
    </div>

    <div class="servicesv3-grid" data-reveal>
      {services.map((s, i) => (
        <div class="servicesv3-card" style={`--grad:${grads[i % grads.length]}`}>
          <span class="servicesv3-index">{s.index}</span>
          <h3>{s.title}</h3>
          <p>{s.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .servicesv3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .servicesv3-card {
    position: relative;
    padding: 1.75rem;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: transform 0.35s var(--ease-bounce);
  }

  .servicesv3-card:hover {
    transform: translateY(-6px);
  }

  .servicesv3-card::before {
    content: "";
    position: absolute;
    top: -40%;
    right: -30%;
    width: 60%;
    height: 60%;
    background: var(--grad);
    filter: blur(30px);
    opacity: 0.4;
    z-index: 0;
  }

  .servicesv3-index,
  .servicesv3-card h3,
  .servicesv3-card p {
    position: relative;
    z-index: 1;
  }

  .servicesv3-index {
    display: block;
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
  }

  .servicesv3-card h3 {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.25rem;
    line-height: 1.1;
    margin-bottom: 0.6rem;
  }

  .servicesv3-card p {
    font-size: 0.88rem;
    color: var(--text-dim);
  }

  .servicesv3-card:nth-child(4),
  .servicesv3-card:nth-child(5) {
    grid-column: span 1;
  }

  @media (max-width: 900px) {
    .servicesv3-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .servicesv3-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
