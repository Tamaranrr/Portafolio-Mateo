---
const socials = [
  { label: "Instagram", href: "https://instagram.com" },
  { label: "Vimeo", href: "https://vimeo.com" },
  { label: "YouTube", href: "https://youtube.com" },
  { label: "LinkedIn", href: "https://linkedin.com" },
];
---

<section class="contactv3 section" id="contacto">
  <div class="container">
    <div class="contactv3-card" data-reveal>
      <div class="blob blob-3" aria-hidden="true"></div>
      <span class="chip"><span class="chip-dot"></span> Contacto</span>
      <h2 class="big-title">
        HAGAMOS ALGO <span class="grad">RUIDOSO.</span>
      </h2>
      <a href="mailto:hola@mateoproductor.com" class="contactv3-email">
        hola@mateoproductor.com
      </a>

      <div class="contactv3-bottom">
        <ul class="contactv3-socials">
          {socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener noreferrer" class="chip">{s.label}</a></li>
          ))}
        </ul>

        <form class="contactv3-form" id="contactv3-form" novalidate>
          <input type="text" name="name" placeholder="Tu nombre" required />
          <input type="email" name="email" placeholder="Tu email" required />
          <textarea name="message" rows="3" placeholder="Cuéntame tu idea" required></textarea>
          <button type="submit" class="btn3 btn3-solid">Enviar ✦</button>
          <p class="contactv3-note" id="contactv3-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contactv3-form") as HTMLFormElement | null;
  const note = document.getElementById("contactv3-note");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (note) note.textContent = "¡Recibido! Te respondo pronto ✦";
    form.reset();
  });
</script>

<style>
  .contactv3-card {
    position: relative;
    padding: clamp(2.5rem, 6vw, 4.5rem);
    border-radius: 32px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    overflow: hidden;
  }

  .blob-3 {
    width: 40%;
    height: 60%;
    top: -10%;
    right: -8%;
    background: var(--gradient-1);
    opacity: 0.3;
  }

  .contactv3-email {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.6vw, 1.7rem);
    color: var(--yellow);
  }

  .contactv3-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    margin-top: 2.5rem;
    align-items: start;
    position: relative;
  }

  .contactv3-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .contactv3-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .contactv3-form input,
  .contactv3-form textarea {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.8rem 1rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text);
    resize: vertical;
    transition: border-color 0.3s var(--ease-out);
  }

  .contactv3-form input:focus,
  .contactv3-form textarea:focus {
    outline: none;
    border-color: var(--cyan);
  }

  .contactv3-form .btn3 {
    align-self: flex-start;
  }

  .contactv3-note {
    font-size: 0.82rem;
    color: var(--cyan);
    min-height: 1.2em;
  }

  @media (max-width: 760px) {
    .contactv3-bottom {
      grid-template-columns: 1fr;
    }
  }
</style>
