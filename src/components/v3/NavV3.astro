---
const links = [
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#trabajo", label: "Trabajo" },
  { href: "#servicios", label: "Servicios" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="navv3" id="navv3">
  <div class="container navv3-inner">
    <a href="#inicio" class="navv3-logo">MATEO<span>*</span></a>

    <nav class="navv3-links">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>

    <a href="#contacto" class="btn3 btn3-solid navv3-cta">Hablemos</a>

    <button class="navv3-toggle" id="navv3-toggle" aria-label="Abrir menú" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="navv3-mobile" id="navv3-mobile">
    {links.map((l, i) => (
      <a href={l.href} style={`--i:${i}`}>{l.label}</a>
    ))}
  </div>
</header>

<script>
  const toggle = document.getElementById("navv3-toggle");
  const mobile = document.getElementById("navv3-mobile");
  const nav = document.getElementById("navv3");

  window.addEventListener("scroll", () => {
    nav?.classList.toggle("is-scrolled", window.scrollY > 30);
  });

  toggle?.addEventListener("click", () => {
    const open = mobile?.classList.toggle("is-open");
    toggle.classList.toggle("is-open", Boolean(open));
    toggle.setAttribute("aria-expanded", String(Boolean(open)));
  });

  mobile?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      mobile.classList.remove("is-open");
      toggle?.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    })
  );
</script>

<style>
  .navv3 {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-block: 1.4rem;
    transition: background 0.3s var(--ease-out), backdrop-filter 0.3s var(--ease-out);
  }

  .navv3.is-scrolled {
    background: rgba(19, 15, 34, 0.75);
    backdrop-filter: blur(10px);
  }

  .navv3-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .navv3-logo {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.02em;
  }

  .navv3-logo span {
    color: var(--pink);
  }

  .navv3-links {
    display: flex;
    gap: clamp(1.2rem, 2.5vw, 2rem);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .navv3-links a {
    transition: color 0.25s var(--ease-out);
  }

  .navv3-links a:hover {
    color: var(--cyan);
  }

  .navv3-cta {
    padding: 0.65rem 1.3rem;
    font-size: 0.7rem;
  }

  .navv3-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 30px;
    z-index: 110;
  }

  .navv3-toggle span {
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
  }

  .navv3-toggle.is-open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .navv3-toggle.is-open span:nth-child(2) {
    opacity: 0;
  }

  .navv3-toggle.is-open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .navv3-mobile {
    position: fixed;
    inset: 0;
    z-index: 99;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s var(--ease-out), visibility 0.35s;
  }

  .navv3-mobile.is-open {
    opacity: 1;
    visibility: visible;
  }

  .navv3-mobile a {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.8rem, 7vw, 2.8rem);
  }

  @media (max-width: 860px) {
    .navv3-links,
    .navv3-cta {
      display: none;
    }

    .navv3-toggle {
      display: flex;
    }
  }
</style>
