---
import { stats } from "../data/content.js";
---

<section class="about section" id="sobre-mi">
  <div class="container about-grid">
    <div class="about-media" data-reveal>
      <img
        src="https://picsum.photos/seed/mateo-productor/900/1100"
        alt="Retrato de Mateo, productor multimedia"
        loading="lazy"
      />
      <div class="about-media-frame"></div>
    </div>

    <div class="about-body">
      <p class="eyebrow" data-reveal>Sobre mí</p>
      <h2 class="section-title" data-reveal>
        Detrás de cámara, <em>frente</em> a la idea.
      </h2>

      <div class="about-copy" data-reveal>
        <p>
          Soy productor multimedia con más de ocho años de experiencia contando
          historias a través del video, la fotografía y el diseño de marca.
          Trabajo desde el concepto hasta la entrega final, cuidando cada
          detalle de la narrativa visual.
        </p>
        <p>
          Mi enfoque combina una mirada cinematográfica con procesos de
          producción sólidos, para que cada proyecto —sin importar su
          escala— tenga una identidad clara y consistente.
        </p>
      </div>

      <div class="about-stats" data-reveal-group>
        {stats.map((s) => (
          <div class="stat">
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .about-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
  }

  .about-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.3) contrast(1.08) brightness(0.92);
  }

  .about-media-frame {
    position: absolute;
    inset: 14px;
    border: 1px solid rgba(245, 243, 235, 0.35);
    pointer-events: none;
  }

  .about-copy {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 52ch;
    color: var(--text-dim);
  }

  .about-stats {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    border-top: 1px solid var(--line);
    padding-top: 1.75rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    color: var(--accent);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--text-faint);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-media {
      max-width: 420px;
    }
  }

  @media (max-width: 560px) {
    .about-stats {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 1.75rem;
    }
  }
</style>
