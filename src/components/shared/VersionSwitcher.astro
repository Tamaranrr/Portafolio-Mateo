---
interface Props {
  current: "v1" | "v2" | "v3" | "v4";
  theme?: "dark" | "light";
}

const { current, theme = "dark" } = Astro.props;

const versions = [
  { id: "v1", href: "/", label: "V1 · Cine" },
  { id: "v2", href: "/v2", label: "V2 · Editorial" },
  { id: "v3", href: "/v3", label: "V3 · Vibrante" },
  { id: "v4", href: "/v4", label: "V4 · Brutalista" },
];
---

<div class:list={["vswitch", `vswitch--${theme}`]}>
  {versions.map((v) => (
    <a
      href={v.href}
      class:list={["vswitch-item", { "is-current": v.id === current }]}
      aria-current={v.id === current ? "page" : undefined}
    >
      {v.label}
    </a>
  ))}
</div>

<style>
  .vswitch {
    position: fixed;
    left: 50%;
    bottom: 1.1rem;
    transform: translateX(-50%);
    z-index: 500;
    display: flex;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: 999px;
    font-family: system-ui, sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.02em;
  }

  .vswitch--dark {
    background: rgba(20, 20, 20, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(8px);
  }

  .vswitch--light {
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .vswitch-item {
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .vswitch--dark .vswitch-item {
    color: rgba(245, 243, 235, 0.55);
  }

  .vswitch--dark .vswitch-item:hover {
    color: #f5f3eb;
  }

  .vswitch--dark .vswitch-item.is-current {
    background: #f5f3eb;
    color: #0a0a0a;
    font-weight: 600;
  }

  .vswitch--light .vswitch-item {
    color: rgba(20, 20, 20, 0.5);
  }

  .vswitch--light .vswitch-item:hover {
    color: #141414;
  }

  .vswitch--light .vswitch-item.is-current {
    background: #141414;
    color: #ffffff;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .vswitch {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
      transform: none;
      justify-content: center;
      flex-wrap: wrap;
    }
  }
</style>
