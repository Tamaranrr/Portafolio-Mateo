---
const socials = [
  { label: "INSTAGRAM", href: "https://instagram.com" },
  { label: "VIMEO", href: "https://vimeo.com" },
  { label: "YOUTUBE", href: "https://youtube.com" },
  { label: "LINKEDIN", href: "https://linkedin.com" },
];
---

<section class="contactv4 section" id="contacto">
  <div class="container contactv4-grid">
    <div data-reveal>
      <p class="label">CONTACTO</p>
      <h2 class="slab">
        HABLEMOS<br /><span class="hl">DE FRENTE.</span>
      </h2>
      <a href="mailto:hola@mateoproductor.com" class="contactv4-email">
        hola@mateoproductor.com
      </a>
      <ul class="contactv4-socials">
        {socials.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
        ))}
      </ul>
    </div>

    <form class="contactv4-form" id="contactv4-form" data-reveal novalidate>
      <label>
        <span>01 / NOMBRE</span>
        <input type="text" name="name" required />
      </label>
      <label>
        <span>02 / EMAIL</span>
        <input type="email" name="email" required />
      </label>
      <label>
        <span>03 / MENSAJE</span>
        <textarea name="message" rows="4" required></textarea>
      </label>
      <button type="submit" class="btn4 btn4-fill">ENVIAR →</button>
      <p class="contactv4-note" id="contactv4-note" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("contactv4-form") as HTMLFormElement | null;
  const note = document.getElementById("contactv4-note");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (note) note.textContent = "> MENSAJE RECIBIDO. RESPUESTA EN CAMINO.";
    form.reset();
  });
</script>

<style>
  .contactv4-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .contactv4-email {
    display: inline-block;
    margin-top: 1.5rem;
    font-weight: 700;
    font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    color: var(--accent);
    border-bottom: var(--bw) solid var(--line);
  }

  .contactv4-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .contactv4-socials a {
    border: var(--bw) solid var(--line);
    padding: 0.5rem 0.9rem;
    font-size: 0.78rem;
    font-weight: 700;
    transition: background 0.12s linear, color 0.12s linear;
  }

  .contactv4-socials a:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .contactv4-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .contactv4-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .contactv4-form label span {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .contactv4-form input,
  .contactv4-form textarea {
    background: var(--paper);
    border: var(--bw) solid var(--line);
    padding: 0.75rem 0.9rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    resize: vertical;
  }

  .contactv4-form input:focus,
  .contactv4-form textarea:focus {
    outline: none;
    background: var(--bg);
  }

  .contactv4-form .btn4 {
    align-self: flex-start;
    margin-top: 0.25rem;
  }

  .contactv4-note {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent);
    min-height: 1.2em;
  }

  @media (max-width: 860px) {
    .contactv4-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
