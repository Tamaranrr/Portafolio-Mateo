---
const ticker = [
  "PRODUCTOR MULTIMEDIA", "VIDEO", "FOTOGRAFÍA", "MOTION GRAPHICS",
  "IDENTIDAD DE MARCA", "DISPONIBLE PARA PROYECTOS 2026",
];
---

<section class="herov4" id="inicio">
  <div class="herov4-ticker" aria-hidden="true">
    <div class="herov4-ticker-track">
      {[...ticker, ...ticker].map((t) => (
        <span>{t} <b>/</b></span>
      ))}
    </div>
  </div>

  <div class="container herov4-body">
    <p class="label" data-reveal>PORTAFOLIO — V.04 RAW</p>

    <h1 class="slab herov4-title" data-reveal>
      MATEO<br />
      PRODUCE<br />
      <span class="hl">IMAGEN.</span><span class="cursor-blink"></span>
    </h1>

    <div class="herov4-row" data-reveal>
      <p class="body-text">
        Productor multimedia. Sin adornos: video, fotografía y motion
        contados directo, sin relleno. Lo que ves es lo que se produce.
      </p>
      <div class="herov4-actions">
        <a href="#trabajo" class="btn4 btn4-fill">VER TRABAJO →</a>
        <a href="#contacto" class="btn4">CONTACTO</a>
      </div>
    </div>
  </div>
</section>

<style>
  .herov4-ticker {
    border-bottom: var(--bw) solid var(--line);
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
    padding-block: 0.55rem;
  }

  .herov4-ticker-track {
    display: flex;
    gap: 0.75rem;
    width: max-content;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    animation: herov4-scroll 22s linear infinite;
  }

  .herov4-ticker-track b {
    color: var(--accent);
    font-weight: 700;
  }

  @keyframes herov4-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .herov4-body {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .herov4-title {
    margin-top: 1.25rem;
  }

  .herov4-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: var(--bw) solid var(--line);
  }

  .herov4-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .herov4-ticker-track {
      animation: none;
    }
  }
</style>
