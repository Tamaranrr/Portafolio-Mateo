---
import { testimonials } from "../../data/content.js";
---

<section class="testiv4 section" id="testimonios">
  <div class="container">
    <p class="label" data-reveal>CLIENTES</p>
    <h2 class="slab" data-reveal>DICEN <span class="hl">ESTO.</span></h2>

    <div class="testiv4-box" data-reveal>
      <div class="testiv4-tabs" id="testiv4-tabs">
        {testimonials.map((_, i) => (
          <button class:list={["testiv4-tab", { "is-active": i === 0 }]} data-index={i}>
            {String(i + 1).padStart(2, "0")}
          </button>
        ))}
      </div>

      <div class="testiv4-panel">
        {testimonials.map((t, i) => (
          <div class:list={["testiv4-item", { "is-active": i === 0 }]} data-item={i}>
            <p class="testiv4-quote"><span class="prompt">&gt;</span> {t.quote}</p>
            <p class="testiv4-name">{t.name} <span>/ {t.role}</span></p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".testiv4-tab");
  const items = document.querySelectorAll<HTMLElement>(".testiv4-item");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const index = tab.dataset.index;
      tabs.forEach((t) => t.classList.toggle("is-active", t === tab));
      items.forEach((item) => item.classList.toggle("is-active", item.dataset.item === index));
    });
  });
</script>

<style>
  .testiv4-box {
    margin-top: 2.5rem;
    border: var(--bw) solid var(--line);
  }

  .testiv4-tabs {
    display: flex;
    border-bottom: var(--bw) solid var(--line);
  }

  .testiv4-tab {
    flex: 1;
    padding: 0.85rem;
    font-weight: 700;
    border-right: var(--bw) solid var(--line);
    transition: background 0.1s linear, color 0.1s linear;
  }

  .testiv4-tab:last-child {
    border-right: none;
  }

  .testiv4-tab:hover {
    background: var(--bg);
  }

  .testiv4-tab.is-active {
    background: var(--ink);
    color: var(--paper);
  }

  .testiv4-panel {
    position: relative;
    padding: clamp(2rem, 5vw, 3rem);
    min-height: 220px;
  }

  .testiv4-item {
    display: none;
  }

  .testiv4-item.is-active {
    display: block;
  }

  .testiv4-quote {
    font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    line-height: 1.5;
  }

  .testiv4-quote .prompt {
    color: var(--accent);
    font-weight: 700;
  }

  .testiv4-name {
    margin-top: 1.5rem;
    font-weight: 700;
    font-size: 0.88rem;
  }

  .testiv4-name span {
    font-weight: 400;
    opacity: 0.7;
  }
</style>
