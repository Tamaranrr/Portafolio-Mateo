---
const links = [
  { href: "#sobre-mi", label: "SOBRE MI" },
  { href: "#trabajo", label: "TRABAJO" },
  { href: "#servicios", label: "SERVICIOS" },
  { href: "#contacto", label: "CONTACTO" },
];
---

<header class="navv4">
  <div class="container navv4-inner">
    <a href="#inicio" class="navv4-logo">MATEO_</a>
    <nav class="navv4-links">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>
    <button class="navv4-toggle" id="navv4-toggle" aria-expanded="false">MENU</button>
  </div>

  <div class="navv4-mobile" id="navv4-mobile">
    {links.map((l, i) => (
      <a href={l.href}>
        <span>{String(i + 1).padStart(2, "0")}</span>{l.label}
      </a>
    ))}
  </div>
</header>

<script>
  const toggle = document.getElementById("navv4-toggle");
  const mobile = document.getElementById("navv4-mobile");

  toggle?.addEventListener("click", () => {
    const open = mobile?.classList.toggle("is-open");
    toggle.textContent = open ? "CERRAR" : "MENU";
    toggle.setAttribute("aria-expanded", String(Boolean(open)));
  });

  mobile?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      mobile.classList.remove("is-open");
      if (toggle) toggle.textContent = "MENU";
      toggle?.setAttribute("aria-expanded", "false");
    })
  );
</script>

<style>
  .navv4 {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: var(--bw) solid var(--line);
  }

  .navv4-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
  }

  .navv4-logo {
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
  }

  .navv4-links {
    display: flex;
    gap: 1.75rem;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .navv4-links a {
    position: relative;
  }

  .navv4-links a:hover {
    color: var(--accent);
  }

  .navv4-toggle {
    display: none;
    border: var(--bw) solid var(--line);
    padding: 0.4rem 0.8rem;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .navv4-toggle:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .navv4-mobile {
    display: none;
    flex-direction: column;
    border-top: var(--bw) solid var(--line);
  }

  .navv4-mobile.is-open {
    display: flex;
  }

  .navv4-mobile a {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 1.1rem var(--gutter);
    border-bottom: var(--bw) solid var(--line);
    font-weight: 700;
    font-size: 1.3rem;
    text-transform: uppercase;
  }

  .navv4-mobile a span {
    color: var(--accent);
    font-size: 0.85rem;
  }

  .navv4-mobile a:hover {
    background: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 780px) {
    .navv4-links {
      display: none;
    }

    .navv4-toggle {
      display: block;
    }
  }
</style>
