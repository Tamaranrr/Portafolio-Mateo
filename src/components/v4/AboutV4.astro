---
import { stats } from "../../data/content.js";
---

<section class="aboutv4 section" id="sobre-mi">
  <div class="container aboutv4-grid">
    <div class="aboutv4-media" data-reveal>
      <img
        src="https://picsum.photos/seed/mateo-brutal/800/1000"
        alt="Retrato de Mateo, productor multimedia"
        loading="lazy"
      />
    </div>

    <div>
      <p class="label" data-reveal>SOBRE MI</p>

      <div class="aboutv4-terminal" data-reveal>
        <p><span class="prompt">$</span> whoami</p>
        <p class="aboutv4-answer">
          Productor multimedia. 8+ años. Video / fotografía / marca.
        </p>
        <p><span class="prompt">$</span> cat bio.txt</p>
        <p class="aboutv4-answer">
          Trabajo el proyecto completo: del concepto a la entrega. Cada
          pieza documentada, cada decisión con propósito. Sin relleno.
        </p>
        <p><span class="prompt">$</span> <span class="cursor-blink"></span></p>
      </div>

      <table class="aboutv4-stats" data-reveal>
        <tbody>
          {stats.map((s) => (
            <tr>
              <td class="aboutv4-val">{s.value}</td>
              <td class="aboutv4-label">{s.label}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .aboutv4-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .aboutv4-media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: var(--bw) solid var(--line);
    filter: grayscale(1) contrast(1.1);
  }

  .aboutv4-terminal {
    margin-top: 1.25rem;
    border: var(--bw) solid var(--line);
    background: var(--ink);
    color: #e8ffe8;
    padding: 1.5rem;
    font-size: 0.88rem;
    line-height: 1.75;
  }

  .prompt {
    color: var(--accent);
    font-weight: 700;
    margin-right: 0.5rem;
  }

  .aboutv4-answer {
    color: #cfd8cf;
    margin-bottom: 0.75rem;
  }

  .aboutv4-stats {
    width: 100%;
    margin-top: 2rem;
    border-collapse: collapse;
    border: var(--bw) solid var(--line);
  }

  .aboutv4-stats tr {
    border-bottom: var(--bw) solid var(--line);
  }

  .aboutv4-stats tr:last-child {
    border-bottom: none;
  }

  .aboutv4-stats td {
    padding: 0.85rem 1rem;
  }

  .aboutv4-val {
    font-weight: 700;
    color: var(--accent);
    width: 5rem;
    border-right: var(--bw) solid var(--line);
  }

  .aboutv4-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .aboutv4-grid {
      grid-template-columns: 1fr;
    }

    .aboutv4-media {
      max-width: 340px;
    }
  }
</style>
