---
import { projects } from "../../data/projects.js";
---

<section class="workv2 section" id="trabajo">
  <div class="container">
    <div class="workv2-head" data-reveal>
      <div>
        <p class="tag">Archivo de proyectos</p>
        <h2 class="headline">Trabajo <em>seleccionado</em></h2>
      </div>
      <div class="workv2-controls">
        <button id="workv2-prev" aria-label="Proyecto anterior">←</button>
        <span id="workv2-count">01 / {String(projects.length).padStart(2, "0")}</span>
        <button id="workv2-next" aria-label="Siguiente proyecto">→</button>
      </div>
    </div>
  </div>

  <div class="workv2-track" id="workv2-track" data-reveal>
    {projects.map((p, i) => (
      <article class="workv2-spread" data-index={i}>
        <div class="workv2-image">
          <img src={p.image} alt={p.title} loading="lazy" />
        </div>
        <div class="workv2-info">
          <span class="workv2-num">{String(i + 1).padStart(2, "0")}</span>
          <h3>{p.title}</h3>
          <p class="workv2-meta">{p.category} · {p.client} · {p.year}</p>
          <p class="workv2-desc">{p.description}</p>
          <ul class="workv2-tags">
            {p.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  const track = document.getElementById("workv2-track");
  const spreads = document.querySelectorAll<HTMLElement>(".workv2-spread");
  const countEl = document.getElementById("workv2-count");
  const prevBtn = document.getElementById("workv2-prev");
  const nextBtn = document.getElementById("workv2-next");
  const total = spreads.length;
  let active = 0;

  const scrollToIndex = (index: number) => {
    active = (index + total) % total;
    spreads[active]?.scrollIntoView({ behavior: "smooth", inline: "start", block: "nearest" });
    countEl!.textContent = `${String(active + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
  };

  prevBtn?.addEventListener("click", () => scrollToIndex(active - 1));
  nextBtn?.addEventListener("click", () => scrollToIndex(active + 1));

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const idx = Number((entry.target as HTMLElement).dataset.index);
          active = idx;
          countEl!.textContent = `${String(idx + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
        }
      });
    },
    { root: track, threshold: 0.6 }
  );
  spreads.forEach((el) => io.observe(el));
</script>

<style>
  .workv2-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .workv2-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--ink-dim);
  }

  .workv2-controls button {
    width: 38px;
    height: 38px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: background 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  .workv2-controls button:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .workv2-track {
    display: flex;
    gap: 1px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    background: var(--line);
    scrollbar-width: none;
  }

  .workv2-track::-webkit-scrollbar {
    display: none;
  }

  .workv2-spread {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    background: var(--bg);
    min-height: 480px;
  }

  .workv2-image {
    overflow: hidden;
  }

  .workv2-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .workv2-info {
    padding: clamp(2rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.9rem;
  }

  .workv2-num {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--accent);
    font-size: 1rem;
  }

  .workv2-info h3 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .workv2-meta {
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--ink-faint);
    text-transform: uppercase;
  }

  .workv2-desc {
    color: var(--ink-dim);
    max-width: 42ch;
  }

  .workv2-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .workv2-tags li {
    font-size: 0.72rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-dim);
  }

  @media (max-width: 820px) {
    .workv2-spread {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .workv2-image {
      aspect-ratio: 4 / 3;
    }
  }
</style>
