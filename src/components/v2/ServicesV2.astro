---
import { services } from "../../data/content.js";
---

<section class="servicesv2 section" id="servicios">
  <div class="container">
    <div class="workv2-head" data-reveal>
      <div>
        <p class="tag">Qué hago</p>
        <h2 class="headline">Servicios</h2>
      </div>
      <p class="lede">Producción audiovisual completa, de la idea a la entrega final.</p>
    </div>

    <ol class="servicesv2-list" data-reveal>
      {services.map((s) => (
        <li>
          <span class="servicesv2-index">{s.index}</span>
          <div class="servicesv2-body">
            <h3>{s.title}</h3>
            <p>{s.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .servicesv2-list {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .servicesv2-list li {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.5rem;
    padding-block: clamp(1.6rem, 3vw, 2.4rem);
    border-bottom: 1px solid var(--line);
  }

  .servicesv2-index {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--accent);
    font-size: 1.1rem;
  }

  .servicesv2-body h3 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    margin-bottom: 0.4rem;
  }

  .servicesv2-body p {
    color: var(--ink-dim);
    max-width: 52ch;
  }
</style>
