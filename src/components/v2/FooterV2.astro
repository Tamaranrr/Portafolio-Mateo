---
const year = new Date().getFullYear();
---

<footer class="footerv2">
  <div class="container footerv2-inner">
    <span class="footerv2-logo">Mateo<span>·</span>Estudio</span>
    <p>&copy; {year} — Todos los derechos reservados.</p>
    <a href="#inicio">Volver arriba ↑</a>
  </div>
</footer>

<style>
  .footerv2 {
    border-top: 1px solid var(--line);
    padding-block: 2.5rem;
  }

  .footerv2-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .footerv2-logo {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--ink);
  }

  .footerv2-logo span {
    color: var(--accent);
    font-style: normal;
    margin-inline: 0.15rem;
  }

  .footerv2-inner a {
    border-bottom: 1px solid var(--line-strong);
  }
</style>
