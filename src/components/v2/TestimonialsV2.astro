---
import { testimonials } from "../../data/content.js";
---

<section class="testiv2 section" id="testimonios">
  <div class="container testiv2-wrap" data-reveal>
    <p class="tag">Clientes</p>
    <div class="testiv2-stage" id="testiv2-stage">
      {testimonials.map((t, i) => (
        <figure class:list={["testiv2-slide", { "is-active": i === 0 }]}>
          <blockquote>&ldquo;{t.quote}&rdquo;</blockquote>
          <figcaption>{t.name} — <span>{t.role}</span></figcaption>
        </figure>
      ))}
    </div>
    <div class="testiv2-dots" id="testiv2-dots">
      {testimonials.map((_, i) => (
        <button class:list={["is-dot", { "is-active": i === 0 }]} data-index={i} aria-label={`Testimonio ${i + 1}`}></button>
      ))}
    </div>
  </div>
</section>

<script>
  const slides = document.querySelectorAll<HTMLElement>(".testiv2-slide");
  const dots = document.querySelectorAll<HTMLButtonElement>(".testiv2-dots .is-dot");
  let active = 0;
  let timer: ReturnType<typeof setInterval>;

  const show = (index: number) => {
    active = (index + slides.length) % slides.length;
    slides.forEach((s, i) => s.classList.toggle("is-active", i === active));
    dots.forEach((d, i) => d.classList.toggle("is-active", i === active));
  };

  const autoplay = () => {
    clearInterval(timer);
    timer = setInterval(() => show(active + 1), 5500);
  };

  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      show(Number(dot.dataset.index));
      autoplay();
    });
  });

  autoplay();
</script>

<style>
  .testiv2-wrap {
    max-width: 780px;
  }

  .testiv2-stage {
    position: relative;
    min-height: 220px;
    margin-top: 1.5rem;
  }

  .testiv2-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
    pointer-events: none;
  }

  .testiv2-slide.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .testiv2-slide blockquote {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.5rem, 3.4vw, 2.3rem);
    line-height: 1.28;
  }

  .testiv2-slide figcaption {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .testiv2-slide figcaption span {
    font-weight: 400;
    color: var(--ink-faint);
  }

  .testiv2-dots {
    display: flex;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .is-dot {
    width: 26px;
    height: 2px;
    background: var(--line-strong);
    transition: background 0.3s var(--ease-out);
  }

  .is-dot.is-active {
    background: var(--accent);
  }
</style>
