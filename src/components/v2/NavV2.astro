---
const links = [
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#trabajo", label: "Trabajo" },
  { href: "#servicios", label: "Servicios" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="navv2" id="nav-v2">
  <div class="container navv2-inner">
    <a href="#inicio" class="navv2-logo">Mateo<span>·</span>Estudio</a>

    <nav class="navv2-links" aria-label="Navegación principal">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>

    <button class="navv2-toggle" id="navv2-toggle" aria-label="Abrir menú" aria-expanded="false">
      <span>Menú</span>
    </button>
  </div>

  <div class="navv2-mobile" id="navv2-mobile">
    {links.map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
  </div>
</header>

<script>
  const toggle = document.getElementById("navv2-toggle");
  const mobile = document.getElementById("navv2-mobile");

  toggle?.addEventListener("click", () => {
    const open = mobile?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(open)));
  });

  mobile?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      mobile.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    })
  );
</script>

<style>
  .navv2 {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .navv2-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.4rem;
  }

  .navv2-logo {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-style: italic;
  }

  .navv2-logo span {
    color: var(--accent);
    font-style: normal;
    margin-inline: 0.15rem;
  }

  .navv2-links {
    display: flex;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    font-size: 0.85rem;
  }

  .navv2-links a {
    position: relative;
  }

  .navv2-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.3s var(--ease-out);
  }

  .navv2-links a:hover::after {
    width: 100%;
  }

  .navv2-toggle {
    display: none;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--ink);
  }

  .navv2-mobile {
    display: none;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .navv2-mobile.is-open {
    display: flex;
  }

  .navv2-mobile a {
    padding: 1rem var(--gutter);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  @media (max-width: 780px) {
    .navv2-links {
      display: none;
    }

    .navv2-toggle {
      display: block;
    }
  }
</style>
