---
import { projects } from "../../data/projects.js";
const slides = projects.slice(0, 4);
---

<section class="herov2" id="inicio">
  <div class="container herov2-grid">
    <div class="herov2-copy">
      <p class="tag" data-reveal>Portafolio — Edición 2026</p>
      <h1 class="headline herov2-title" data-reveal>
        La producción<br />audiovisual como <em>oficio</em>.
      </h1>
      <p class="lede" data-reveal>
        Soy Mateo, productor multimedia. Este es un archivo curado de video,
        fotografía, motion e identidad de marca — cada proyecto documentado
        como una historia completa.
      </p>
      <div class="herov2-actions" data-reveal>
        <a href="#trabajo" class="btn-solid">Ver el archivo</a>
        <a href="#contacto" class="btn-line">
          Contactar
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17 17 7M7 7h10v10" />
          </svg>
        </a>
      </div>
    </div>

    <div class="herov2-cover" data-reveal>
      <div class="cover-slider" id="cover-slider">
        {slides.map((s, i) => (
          <figure class:list={["cover-slide", { "is-active": i === 0 }]} data-index={i}>
            <img src={s.image} alt={s.title} loading={i === 0 ? "eager" : "lazy"} />
          </figure>
        ))}
      </div>
      <div class="cover-caption">
        <span class="cover-count"><span id="cover-current">01</span> / {String(slides.length).padStart(2, "0")}</span>
        <span class="cover-title" id="cover-title">{slides[0].title}</span>
      </div>
      <div class="cover-nav">
        <button id="cover-prev" aria-label="Anterior">←</button>
        <button id="cover-next" aria-label="Siguiente">→</button>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ titles: slides.map((s) => s.title) }}>
  const slidesEls = document.querySelectorAll("#cover-slider .cover-slide");
  const currentLabel = document.getElementById("cover-current");
  const titleLabel = document.getElementById("cover-title");
  const prevBtn = document.getElementById("cover-prev");
  const nextBtn = document.getElementById("cover-next");
  let active = 0;
  let timer;

  const render = (index) => {
    active = (index + slidesEls.length) % slidesEls.length;
    slidesEls.forEach((el, i) => el.classList.toggle("is-active", i === active));
    currentLabel.textContent = String(active + 1).padStart(2, "0");
    titleLabel.textContent = titles[active];
  };

  const autoplay = () => {
    clearInterval(timer);
    timer = setInterval(() => render(active + 1), 4500);
  };

  prevBtn.addEventListener("click", () => {
    render(active - 1);
    autoplay();
  });
  nextBtn.addEventListener("click", () => {
    render(active + 1);
    autoplay();
  });

  render(0);
  autoplay();
</script>

<style>
  .herov2 {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .herov2-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .herov2-title {
    margin-block: 1.5rem;
  }

  .herov2-actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-top: 2.25rem;
    flex-wrap: wrap;
  }

  .herov2-cover {
    position: relative;
  }

  .cover-slider {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 2px;
    background: var(--ink);
  }

  .cover-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s var(--ease-out);
  }

  .cover-slide.is-active {
    opacity: 1;
  }

  .cover-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 1.1rem;
    border-top: 1px solid var(--line);
    padding-top: 0.9rem;
  }

  .cover-count {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--accent);
    font-size: 0.95rem;
  }

  .cover-title {
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--ink-dim);
  }

  .cover-nav {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    gap: 0.5rem;
  }

  .cover-nav button {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(251, 249, 244, 0.9);
    color: var(--ink);
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.25s var(--ease-out);
  }

  .cover-nav button:hover {
    background: var(--accent);
    color: var(--paper);
  }

  @media (max-width: 900px) {
    .herov2-grid {
      grid-template-columns: 1fr;
    }

    .herov2-cover {
      max-width: 460px;
    }
  }
</style>
