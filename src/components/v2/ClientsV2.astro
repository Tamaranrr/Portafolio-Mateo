---
import { clients } from "../../data/content.js";
---

<section class="clientsv2" aria-label="Marcas y clientes">
  <div class="container">
    <ul class="clientsv2-grid" data-reveal>
      {clients.map((c) => (
        <li>{c}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .clientsv2 {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .clientsv2-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
  }

  .clientsv2-grid li {
    background: var(--bg);
    padding: 1.4rem 1rem;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--ink-dim);
    transition: color 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }

  .clientsv2-grid li:hover {
    color: var(--accent);
    background: var(--paper);
  }

  @media (max-width: 700px) {
    .clientsv2-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
