---
import { stats } from "../../data/content.js";
---

<section class="aboutv2 section" id="sobre-mi">
  <div class="container aboutv2-grid">
    <div class="aboutv2-media" data-reveal>
      <img
        src="https://picsum.photos/seed/mateo-editorial/800/1000"
        alt="Retrato de Mateo, productor multimedia"
        loading="lazy"
      />
      <span class="aboutv2-caption">Fig. 01 — Mateo, en set.</span>
    </div>

    <div class="aboutv2-copy">
      <p class="tag" data-reveal>Perfil</p>
      <h2 class="headline" data-reveal>Sobre <em>mí</em></h2>

      <p class="aboutv2-dropcap" data-reveal>
        Soy productor multimedia con más de ocho años documentando historias
        en video, fotografía y diseño de marca. Trabajo el proyecto completo
        —del concepto a la entrega— cuidando que cada pieza tenga una
        narrativa propia y consistente.
      </p>
      <p class="lede" data-reveal>
        Mi archivo combina encargos editoriales, campañas de marca y
        proyectos personales, siempre desde una mirada cinematográfica.
      </p>

      <dl class="aboutv2-stats" data-reveal>
        {stats.map((s) => (
          <div>
            <dt>{s.value}</dt>
            <dd>{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .aboutv2-grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .aboutv2-media {
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .aboutv2-media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(0.15) sepia(0.06);
  }

  .aboutv2-caption {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.75rem;
    font-style: italic;
    color: var(--ink-faint);
  }

  .aboutv2-dropcap {
    margin-top: 1.5rem;
    font-size: 1.15rem;
    max-width: 58ch;
  }

  .aboutv2-dropcap::first-letter {
    font-family: var(--font-display);
    font-size: 3.6rem;
    font-weight: 500;
    float: left;
    line-height: 0.8;
    padding-right: 0.6rem;
    padding-top: 0.2rem;
    color: var(--accent);
  }

  .aboutv2-copy .lede {
    margin-top: 1.1rem;
    max-width: 58ch;
  }

  .aboutv2-stats {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 2rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }

  .aboutv2-stats dt {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-style: italic;
    color: var(--accent);
  }

  .aboutv2-stats dd {
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--ink-faint);
    margin-top: 0.2rem;
  }

  @media (max-width: 900px) {
    .aboutv2-grid {
      grid-template-columns: 1fr;
    }

    .aboutv2-media {
      position: static;
      max-width: 340px;
    }
  }

  @media (max-width: 560px) {
    .aboutv2-stats {
      grid-template-columns: repeat(2, auto);
      row-gap: 1.5rem;
    }
  }
</style>
