---
const socials = [
  { label: "Instagram", href: "https://instagram.com" },
  { label: "Vimeo", href: "https://vimeo.com" },
  { label: "LinkedIn", href: "https://linkedin.com" },
];
---

<section class="contactv2 section" id="contacto">
  <div class="container contactv2-grid">
    <div data-reveal>
      <p class="tag">Contacto</p>
      <h2 class="headline">
        Trabajemos en tu <em>próxima</em><br />historia.
      </h2>
      <a href="mailto:hola@mateoproductor.com" class="contactv2-email">
        hola@mateoproductor.com
      </a>
      <ul class="contactv2-socials">
        {socials.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
        ))}
      </ul>
    </div>

    <form class="contactv2-form" id="contactv2-form" data-reveal novalidate>
      <label>
        <span>Nombre</span>
        <input type="text" name="name" required />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" required />
      </label>
      <label>
        <span>Mensaje</span>
        <textarea name="message" rows="4" required></textarea>
      </label>
      <button type="submit" class="btn-solid">Enviar mensaje</button>
      <p class="contactv2-note" id="contactv2-note" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("contactv2-form") as HTMLFormElement | null;
  const note = document.getElementById("contactv2-note");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (note) note.textContent = "Gracias — tu mensaje fue recibido. Te responderé pronto.";
    form.reset();
  });
</script>

<style>
  .contactv2-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .contactv2-email {
    display: inline-block;
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    color: var(--accent);
  }

  .contactv2-socials {
    display: flex;
    gap: 1.5rem;
    margin-top: 2.25rem;
    font-size: 0.85rem;
  }

  .contactv2-socials a {
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.2rem;
    transition: border-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }

  .contactv2-socials a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .contactv2-form {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }

  .contactv2-form label {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .contactv2-form label span {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .contactv2-form input,
  .contactv2-form textarea {
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    padding: 0.75rem 0.9rem;
    font-family: var(--font-body);
    font-size: 1rem;
    resize: vertical;
    transition: border-color 0.3s var(--ease-out);
  }

  .contactv2-form input:focus,
  .contactv2-form textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  .contactv2-form .btn-solid {
    align-self: flex-start;
    margin-top: 0.25rem;
  }

  .contactv2-note {
    font-size: 0.85rem;
    color: var(--accent);
    min-height: 1.2em;
  }

  @media (max-width: 860px) {
    .contactv2-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
