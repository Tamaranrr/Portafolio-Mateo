---
import { getImage } from "astro:assets";
import { projects } from "../data/projects.js";
import { categories } from "../data/categories.js";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const slugByLabel = Object.fromEntries(categories.map((c) => [c.label, c.slug]));

const localImageModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/proyectos/**/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);

const cardImages = await Promise.all(
  projects.map(async (p) => {
    if (/^https?:\/\//.test(p.image)) return p.image;
    const mod = localImageModules[`/src/assets/${p.image}`];
    if (!mod) {
      console.warn(`[Work.astro] No se encontró la imagen local "${p.image}" para el proyecto "${p.title}".`);
      return p.image;
    }
    const optimized = await getImage({ src: mod.default, width: 1400 });
    return optimized.src;
  })
);
---

<section class="work section" id="trabajo">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Trabajo seleccionado</p>
        <h2 class="section-title">Proyectos <em>recientes</em></h2>
      </div>
      <p class="lede">
        Una selección de producciones audiovisuales, fotográficas y de marca
        desarrolladas en los últimos años.
      </p>
    </div>

    <div class="work-filters" data-reveal role="tablist" aria-label="Categorías de proyectos">
      <span class="filter-btn is-active" role="tab" aria-selected="true">Todos</span>
      {categories.map((cat) => (
        <a
          href={`${base}/proyectos/${cat.slug}`}
          class="filter-btn"
          role="tab"
          aria-selected="false"
          data-cursor-hover
        >
          {cat.label}
        </a>
      ))}
    </div>

    <div class="work-grid" id="work-grid" data-reveal-group>
      {projects.map((p, i) => (
        <a
          href={`${base}/proyectos/${slugByLabel[p.category] ?? ""}`}
          class="work-card"
          data-cursor-hover
        >
          <span class="work-card-media">
            <img src={cardImages[i]} alt={p.title} loading="lazy" />
          </span>
          <span class="work-card-info">
            <span class="work-card-title">{p.title}</span>
            <span class="work-card-meta">{p.category}{p.year ? ` · ${p.year}` : ""}</span>
            <span class="work-card-desc">{p.description}</span>
            <span class="work-card-cta">
              Ver fotos completas
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
            </span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .work-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .filter-btn {
    padding: 0.55rem 1.2rem;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-dim);
    transition: border-color 0.3s var(--ease-out), color 0.3s var(--ease-out),
      background 0.3s var(--ease-out);
  }

  .filter-btn:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }

  .filter-btn.is-active {
    color: #0a0a0a;
    background: var(--accent);
    border-color: var(--accent);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-align: left;
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface);
  }

  .work-card-media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .work-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.55) brightness(0.75);
    transition: transform 0.7s var(--ease-out), filter 0.5s var(--ease-out);
  }

  .work-card-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 40%,
      rgba(10, 10, 10, 0.92) 100%
    );
  }

  .work-card:hover .work-card-media img {
    transform: scale(1.06);
    filter: grayscale(0) brightness(0.95);
  }

  .work-card-info {
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    z-index: 1;
  }

  .work-card-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.25rem;
    line-height: 1.05;
  }

  .work-card-meta {
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.03em;
  }

  .work-card-desc {
    margin-top: 0.35rem;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--text-dim);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    margin-top: 0.75rem;
    padding: 0.5rem 0.9rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #0a0a0a;
    background: var(--accent);
    border-radius: 999px;
    transition: transform 0.3s var(--ease-out), filter 0.3s var(--ease-out);
  }

  .work-card-cta svg {
    width: 12px;
    height: 12px;
  }

  .work-card:hover .work-card-cta {
    transform: translateX(2px);
    filter: brightness(1.08);
  }

  @media (max-width: 980px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
