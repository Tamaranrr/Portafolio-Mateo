---
import LayoutV2 from "../layouts/LayoutV2.astro";
import NavV2 from "../components/v2/NavV2.astro";
import HeroV2 from "../components/v2/HeroV2.astro";
import AboutV2 from "../components/v2/AboutV2.astro";
import WorkV2 from "../components/v2/WorkV2.astro";
import ServicesV2 from "../components/v2/ServicesV2.astro";
import TestimonialsV2 from "../components/v2/TestimonialsV2.astro";
import ClientsV2 from "../components/v2/ClientsV2.astro";
import ContactV2 from "../components/v2/ContactV2.astro";
import FooterV2 from "../components/v2/FooterV2.astro";
import VersionSwitcher from "../components/shared/VersionSwitcher.astro";
---

<LayoutV2>
  <NavV2 />
  <main>
    <HeroV2 />
    <AboutV2 />
    <WorkV2 />
    <ServicesV2 />
    <TestimonialsV2 />
    <ClientsV2 />
    <ContactV2 />
  </main>
  <FooterV2 />
  <VersionSwitcher current="v2" theme="light" />
</LayoutV2>
