---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { categories } from "../../data/categories.js";
import { publicaciones } from "../../data/publicaciones.js";

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const subcategories = (category.subcategories ?? []) as {
  slug: string;
  label: string;
  description?: string;
}[];

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/proyectos/**/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);

const catPubs = publicaciones.filter((p) => p.category === category.slug);
const pubCovers = new Set(catPubs.map((p) => `/src/assets/${p.cover}`));

const pathPattern = new RegExp(`/proyectos/${category.slug}/(?:([^/]+)/)?[^/]+$`);

const galleryImages = Object.entries(imageModules)
  .filter(([path]) => !pubCovers.has(path))
  .map(([path, mod]) => {
    const match = path.match(pathPattern);
    if (!match) return null;
    const subcat = match[1] && subcategories.some((s) => s.slug === match[1]) ? match[1] : null;
    return { path, img: mod.default, subcat };
  })
  .filter((entry): entry is { path: string; img: ImageMetadata; subcat: string | null } => entry !== null)
  .sort((a, b) => a.path.localeCompare(b.path));

const pubCoverImages = Object.fromEntries(
  Object.entries(imageModules).map(([path, mod]) => [path, mod.default])
);
---

<Layout
  title={`${category.label} · Mateo`}
  description={`Proyectos de ${category.label.toLowerCase()}, portafolio de Mateo, productor multimedia.`}
>
  <header class="cat-nav">
    <div class="container cat-nav-inner">
      <a href={`${base}/`} class="cat-logo" data-cursor-hover>
        <span class="cat-logo-mark">M.</span>
        <span class="cat-logo-text">Mateo</span>
      </a>
      <a href={`${base}/#trabajo`} class="btn" data-cursor-hover>&larr; Volver al inicio</a>
    </div>
  </header>

  <main>
    <section class="cat-hero section">
      <div class="container">
        <p class="eyebrow" data-reveal>Proyectos</p>
        <h1 class="cat-title" data-reveal>{category.label}</h1>

        {category.description && (
          <p class="cat-desc" data-reveal>{category.description}</p>
        )}

        <div class="cat-filters" data-reveal role="tablist" aria-label="Otras categorías de proyectos">
          {categories.map((c) => (
            <a
              href={`${base}/proyectos/${c.slug}`}
              class:list={["cat-filter", { "is-active": c.slug === category.slug }]}
              aria-current={c.slug === category.slug ? "page" : undefined}
              data-cursor-hover
            >
              {c.label}
            </a>
          ))}
        </div>

        {galleryImages.length > 0 && subcategories.length > 0 && (
          <div class="cat-subfilters" data-reveal role="tablist" aria-label={`Tipos de ${category.label.toLowerCase()}`}>
            <button class="cat-subfilter is-active" data-subfilter="todos" data-cursor-hover>Todos</button>
            {subcategories.map((s) => (
              <button class="cat-subfilter" data-subfilter={s.slug} data-cursor-hover>{s.label}</button>
            ))}
          </div>
        )}

        {galleryImages.length > 0 && subcategories.some((s) => s.description) && (
          <div class="cat-subdescs" data-reveal>
            {subcategories.map((s) => (
              s.description && (
                <p class="cat-subdesc" data-subdesc={s.slug} hidden>{s.description}</p>
              )
            ))}
          </div>
        )}

        {catPubs.length > 0 && (
          <div class="cat-pubs" data-reveal-group>
            {catPubs.map((pub) => (
              <article class="cat-pub" data-subcat={pub.subcat ?? ""}>
                <button
                  class="cat-pub-cover"
                  data-cursor-hover
                  data-reader={`${base}/${pub.reader}`}
                  data-pages={pub.pages}
                  data-reader-title={pub.title}
                  aria-label={`Ver la publicación ${pub.title}`}
                >
                  {pubCoverImages[`/src/assets/${pub.cover}`] && (
                    <Image
                      src={pubCoverImages[`/src/assets/${pub.cover}`]}
                      alt={`Portada de ${pub.title}`}
                      width={720}
                      loading="lazy"
                    />
                  )}
                </button>
                <div class="cat-pub-body">
                  {pub.meta && <p class="cat-pub-meta">{pub.meta}</p>}
                  <h2 class="cat-pub-title">{pub.title}</h2>
                  {pub.client && <p class="cat-pub-client">{pub.client}</p>}
                  {pub.description && <p class="cat-pub-desc">{pub.description}</p>}
                  <button
                    class="cat-pub-link"
                    data-cursor-hover
                    data-reader={`${base}/${pub.reader}`}
                    data-pages={pub.pages}
                    data-reader-title={pub.title}
                  >
                    Ver publicación
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                      <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                  </button>
                </div>
              </article>
            ))}
          </div>
        )}

        {catPubs.length > 0 && (
          <div class="cat-reader" id="cat-reader" aria-hidden="true">
            <div class="cat-reader-backdrop" data-reader-close></div>
            <div class="cat-reader-panel" role="dialog" aria-modal="true" aria-label="Lector de la publicación">
              <div class="cat-reader-bar">
                <span class="cat-reader-name" id="cat-reader-name"></span>
                <span class="cat-reader-count" id="cat-reader-count"></span>
                <button class="cat-reader-close" data-reader-close aria-label="Cerrar" data-cursor-hover>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path d="M6 6l12 12M18 6 6 18" />
                  </svg>
                </button>
              </div>
              <div class="cat-reader-pages" id="cat-reader-pages" oncontextmenu="return false"></div>
            </div>
          </div>
        )}

        {galleryImages.length > 0 ? (
          <div class="cat-gallery" id="cat-gallery" data-reveal-group>
            {galleryImages.map((entry, i) => (
              <button
                class="cat-photo"
                data-subcat={entry.subcat ?? ""}
                data-cursor-hover
                aria-label={`Ampliar foto ${i + 1} de ${category.label}`}
              >
                <Image
                  src={entry.img}
                  alt={`${category.label}, foto ${i + 1}`}
                  width={900}
                  loading={i < 3 ? "eager" : "lazy"}
                />
              </button>
            ))}
          </div>
        ) : (
          <div class="cat-empty" data-reveal>
            <p>Próximamente.</p>
            <p>Esta categoría está lista para recibir las fotos y diseños de &ldquo;{category.label}&rdquo;.</p>
          </div>
        )}
      </div>
    </section>
  </main>

  {galleryImages.length > 0 && (
    <div class="cat-lightbox" id="cat-lightbox" aria-hidden="true">
      <div class="cat-lightbox-backdrop" data-lightbox-close></div>
      <button class="cat-lightbox-close" data-lightbox-close aria-label="Cerrar" data-cursor-hover>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
      <img id="cat-lightbox-img" src="" alt="" />
    </div>
  )}

  <Footer />
</Layout>

<script>
    const photos = document.querySelectorAll<HTMLButtonElement>(".cat-photo");
    const lightbox = document.getElementById("cat-lightbox");
    const lightboxImg = document.getElementById("cat-lightbox-img") as HTMLImageElement | null;

    const openLightbox = (src: string, alt: string) => {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      lightbox.classList.add("is-open");
      lightbox.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.remove("is-open");
      lightbox.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    photos.forEach((btn) => {
      const img = btn.querySelector("img");
      btn.addEventListener("click", () => {
        if (img) openLightbox(img.currentSrc || img.src, img.alt);
      });
    });

    lightbox?.querySelectorAll("[data-lightbox-close]").forEach((el) =>
      el.addEventListener("click", closeLightbox)
    );

    // Lector de publicaciones: páginas como imágenes, sin PDF descargable
    const reader = document.getElementById("cat-reader");
    const readerPages = document.getElementById("cat-reader-pages");
    const readerName = document.getElementById("cat-reader-name");
    const readerCount = document.getElementById("cat-reader-count");
    let pageObserver: IntersectionObserver | null = null;

    const openReader = (dir: string, pages: number, title: string) => {
      if (!reader || !readerPages) return;
      readerPages.innerHTML = "";
      readerPages.scrollTop = 0;
      if (readerName) readerName.textContent = title;
      if (readerCount) readerCount.textContent = `1 / ${pages}`;

      pageObserver?.disconnect();
      pageObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const img = entry.target as HTMLImageElement;
            if (entry.isIntersecting) {
              if (!img.src && img.dataset.src) img.src = img.dataset.src;
              if (readerCount && entry.intersectionRatio > 0.5) {
                readerCount.textContent = `${img.dataset.page} / ${pages}`;
              }
            }
          });
        },
        { root: readerPages, rootMargin: "1200px 0px", threshold: [0, 0.5] }
      );

      for (let i = 1; i <= pages; i++) {
        const n = String(i).padStart(3, "0");
        const img = document.createElement("img");
        img.className = "cat-reader-page";
        img.alt = `${title}, página ${i}`;
        img.dataset.src = `${dir}/${n}.jpg`;
        img.dataset.page = String(i);
        img.draggable = false;
        if (i <= 2) img.src = img.dataset.src;
        readerPages.appendChild(img);
        pageObserver.observe(img);
      }

      reader.classList.add("is-open");
      reader.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const closeReader = () => {
      if (!reader || !readerPages) return;
      reader.classList.remove("is-open");
      reader.setAttribute("aria-hidden", "true");
      pageObserver?.disconnect();
      pageObserver = null;
      readerPages.innerHTML = "";
      document.body.style.overflow = "";
    };

    document.querySelectorAll<HTMLElement>("[data-reader]").forEach((el) => {
      el.addEventListener("click", () => {
        openReader(
          el.dataset.reader ?? "",
          Number(el.dataset.pages ?? "0"),
          el.dataset.readerTitle ?? "Publicación"
        );
      });
    });
    reader?.querySelectorAll("[data-reader-close]").forEach((el) =>
      el.addEventListener("click", closeReader)
    );

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeLightbox();
        closeReader();
      }
    });

    const subfilterBtns = document.querySelectorAll<HTMLButtonElement>(".cat-subfilter");
    const subdescs = document.querySelectorAll<HTMLElement>(".cat-subdesc");
    const filterables = document.querySelectorAll<HTMLElement>(".cat-photo, .cat-pub");
    subfilterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        subfilterBtns.forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");

        const filter = btn.dataset.subfilter;
        filterables.forEach((el) => {
          const match = filter === "todos" || el.dataset.subcat === filter;
          el.style.display = match ? "" : "none";
        });
        subdescs.forEach((el) => {
          el.hidden = filter === "todos" || el.dataset.subdesc !== filter;
        });
      });
    });
</script>

<style>
  .cat-nav {
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
  }

  .cat-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .cat-logo {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.3rem;
    letter-spacing: 0.02em;
  }

  .cat-logo-mark {
    color: var(--accent);
  }

  .cat-hero {
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  .cat-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 400;
    font-size: clamp(2.4rem, 7vw, 5rem);
    line-height: 1.04;
    letter-spacing: var(--display-tracking);
    margin-top: 0.5rem;
  }

  .cat-desc {
    max-width: 56ch;
    margin-top: 1.25rem;
    color: var(--text-dim);
    font-size: 1.02rem;
  }

  .cat-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .cat-filter {
    padding: 0.55rem 1.2rem;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-dim);
    transition: border-color 0.3s var(--ease-out), color 0.3s var(--ease-out),
      background 0.3s var(--ease-out);
  }

  .cat-filter:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }

  .cat-filter.is-active {
    color: #0a0a0a;
    background: var(--accent);
    border-color: var(--accent);
  }

  .cat-subfilters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  .cat-subfilter {
    padding: 0.4rem 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-faint);
    border: 1px solid transparent;
    border-radius: 999px;
    transition: color 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }

  .cat-subfilter:hover {
    color: var(--text);
  }

  .cat-subfilter.is-active {
    color: var(--accent);
    border-color: var(--accent);
  }

  .cat-subdescs:has(.cat-subdesc:not([hidden])) {
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
  }

  .cat-subdesc {
    max-width: 60ch;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    color: var(--text-dim);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .cat-pubs {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: 1.6rem;
  }

  .cat-pub {
    display: grid;
    grid-template-columns: minmax(0, 300px) 1fr;
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--line);
  }

  .cat-pub-cover {
    display: block;
    width: 100%;
    padding: 0;
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface);
  }

  .cat-pub-cover img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.6s var(--ease-out);
  }

  .cat-pub-cover:hover img {
    transform: scale(1.03);
  }

  .cat-pub-meta {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .cat-pub-title {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.2rem, 2.6vw, 1.7rem);
    line-height: 1.15;
    letter-spacing: 0.04em;
    margin-top: 0.4rem;
  }

  .cat-pub-client {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .cat-pub-desc {
    margin-top: 0.75rem;
    max-width: 60ch;
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .cat-pub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    padding: 0.55rem 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #0a0a0a;
    background: var(--accent);
    border-radius: 999px;
    transition: transform 0.3s var(--ease-out), filter 0.3s var(--ease-out);
  }

  .cat-pub-link svg {
    width: 12px;
    height: 12px;
  }

  .cat-pub-link:hover {
    transform: translateX(2px);
    filter: brightness(1.08);
  }

  @media (max-width: 640px) {
    .cat-pub {
      grid-template-columns: 1fr;
    }

    .cat-pub-cover {
      max-width: 320px;
    }
  }

  /* Lector de publicaciones (páginas como imágenes) */
  .cat-reader {
    position: fixed;
    inset: 0;
    z-index: 320;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.5rem, 3vw, 2.5rem);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s var(--ease-out), visibility 0.35s;
  }

  .cat-reader.is-open {
    opacity: 1;
    visibility: visible;
  }

  .cat-reader-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 6, 6, 0.94);
    backdrop-filter: blur(4px);
  }

  .cat-reader-panel {
    position: relative;
    z-index: 1;
    width: min(1000px, 100%);
    height: min(92vh, 100%);
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    overflow: hidden;
  }

  .cat-reader-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 0.9rem 0.7rem 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .cat-reader-name {
    flex: 1;
    min-width: 0;
    font-size: 0.82rem;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cat-reader-count {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .cat-reader-close {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    flex-shrink: 0;
  }

  .cat-reader-close svg {
    width: 15px;
    height: 15px;
  }

  .cat-reader-pages {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: #2a2a2a;
    padding: 1rem clamp(0.5rem, 2vw, 1.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }

  .cat-reader-page {
    width: 100%;
    max-width: 900px;
    height: auto;
    background: #1a1a1a;
    border-radius: 2px;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .cat-empty {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding: clamp(2.5rem, 6vw, 4rem);
    border: 1px dashed var(--line-strong);
    border-radius: 6px;
    text-align: center;
    color: var(--text-dim);
  }

  .cat-empty p:first-child {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.4rem;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .cat-gallery {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
    column-count: 1;
    column-gap: 1.1rem;
  }

  .cat-photo {
    display: block;
    width: 100%;
    break-inside: avoid;
    margin-bottom: 1.1rem;
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface);
  }

  .cat-photo img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(0.35) brightness(0.92);
    transition: transform 0.6s var(--ease-out), filter 0.4s var(--ease-out);
  }

  .cat-photo:hover img {
    transform: scale(1.03);
    filter: grayscale(0) brightness(1);
  }

  @media (min-width: 640px) {
    .cat-gallery {
      column-count: 2;
    }
  }

  @media (min-width: 980px) {
    .cat-gallery {
      column-count: 3;
    }
  }

  .cat-lightbox {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s var(--ease-out), visibility 0.4s;
  }

  .cat-lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  .cat-lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 6, 6, 0.92);
    backdrop-filter: blur(4px);
  }

  .cat-lightbox img {
    position: relative;
    max-width: min(1100px, 100%);
    max-height: 88vh;
    object-fit: contain;
    border-radius: 4px;
  }

  .cat-lightbox-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 2;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(10, 10, 10, 0.6);
    border: 1px solid var(--line-strong);
  }

  .cat-lightbox-close svg {
    width: 18px;
    height: 18px;
  }
</style>
