---
import LayoutV4 from "../layouts/LayoutV4.astro";
import NavV4 from "../components/v4/NavV4.astro";
import HeroV4 from "../components/v4/HeroV4.astro";
import AboutV4 from "../components/v4/AboutV4.astro";
import WorkV4 from "../components/v4/WorkV4.astro";
import ServicesV4 from "../components/v4/ServicesV4.astro";
import TestimonialsV4 from "../components/v4/TestimonialsV4.astro";
import ClientsV4 from "../components/v4/ClientsV4.astro";
import ContactV4 from "../components/v4/ContactV4.astro";
import FooterV4 from "../components/v4/FooterV4.astro";
import VersionSwitcher from "../components/shared/VersionSwitcher.astro";
---

<LayoutV4>
  <NavV4 />
  <main>
    <HeroV4 />
    <AboutV4 />
    <WorkV4 />
    <ServicesV4 />
    <TestimonialsV4 />
    <ClientsV4 />
    <ContactV4 />
  </main>
  <FooterV4 />
  <VersionSwitcher current="v4" theme="light" />
</LayoutV4>
